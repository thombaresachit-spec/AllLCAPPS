#include <stdio.h>

// Function declarations (prototypes)
unsigned long long factorialIterative(int n);
unsigned long long factorialRecursive(int n);

int main() {
    int num;

    printf("Enter a positive integer: ");
    scanf("%d", &num);

    // Check for negative numbers
    if (num < 0) {
        printf("Error! Factorial of a negative number doesn't exist.\n");
    } else {
        printf("Factorial of %d (without recursion) = %llu\n", num, factorialIterative(num));
        printf("Factorial of %d (with recursion)    = %llu\n", num, factorialRecursive(num));
    }

    return 0;
}

// 1. Function to find factorial WITHOUT recursion (Iterative approach)
unsigned long long factorialIterative(int n) {
    unsigned long long fact = 1;
    for (int i = 1; i <= n; i++) {
        fact *= i;
    }
    return fact;
}

// 2. Function to find factorial WITH recursion
unsigned long long factorialRecursive(int n) {
    if (n == 0 || n == 1) {
        return 1; // Base case
    }
    return n * factorialRecursive(n - 1); // Recursive call
}
