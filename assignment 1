#include <stdio.h>
#include <string.h>

int main() {
    char email[100], password[100];
    const char valid_email[] = "student@mitwpu.edu.in";
    const char valid_password[] = "Password@123";

    printf("Enter Email ID: ");
    scanf("%99s", email);

    if (strcmp(email, valid_email) != 0) {
        printf("Invalid Email ID. Access Denied.\n");
        return 0;
    }

    printf("Enter Password: ");
    scanf("%99s", password);

    if (strcmp(password, valid_password) == 0) {
        printf("Login Successful! Redirecting to Gmail Inbox...\n");
    } else {
        printf("Incorrect Password. Access Denied.\n");
    }

    return 0;
}
