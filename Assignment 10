#include <stdio.h>
#include <time.h>

// Function to check if a year is a leap year
int isLeapYear(int year) {
    return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

// Function to get the starting day of the week (0 = Sun, 1 = Mon, ..., 6 = Sat)
// Uses <time.h> to fulfill the date and time implementation objective
int getFirstDayOfMonth(int year, int month) {
    struct tm time_in = {0};
    time_in.tm_year = year - 1900; // Years since 1900
    time_in.tm_mon = month;        // Months since January (0-11)
    time_in.tm_mday = 1;           // 1st day of the month

    mktime(&time_in);              // Normalizes the structure and sets tm_wday
    return time_in.tm_wday;
}

int main() {
    int year;

    char *months[] = {
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    };

    int daysInMonth[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

    printf("Enter the year (e.g., 2026): ");
    if (scanf("%d", &year) != 1 || year < 1900) {
        printf("Invalid input. Please enter a valid year (1900 or later).\n");
        return 1;
    }

    // Update February days if it is a leap year
    if (isLeapYear(year)) {
        daysInMonth[1] = 29;
    }

    printf("\n==================== CALENDAR - %d ====================\n", year);

    for (int month = 0; month < 12; month++) {
        int startDay = getFirstDayOfMonth(year, month);
        int totalDays = daysInMonth[month];

        // Print Month Header
        printf("\n  ------------ %s ------------\n", months[month]);
        printf("  Sun  Mon  Tue  Wed  Thu  Fri  Sat\n");

        // Print leading spaces for the first week
        for (int space = 0; space < startDay; space++) {
            printf("     ");
        }

        // Print all days of the month
        for (int day = 1; day <= totalDays; day++) {
            printf("%5d", day);

            // Move to the next line after Saturday
            if ((startDay + day) % 7 == 0) {
                printf("\n");
            }
        }
        printf("\n");
    }

    return 0;
}
